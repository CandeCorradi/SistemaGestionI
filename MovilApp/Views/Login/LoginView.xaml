<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilApp.Views.Login.LoginView"
             xmlns:viewModels="clr-namespace:MovilApp.ViewModels.Login"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1B2A3E">    
    <ContentPage.BindingContext>
        <viewModels:LoginViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" Padding="30" Spacing="0">

            <Image Source="logo_carpinteria.png" 
                   HeightRequest="180" 
                   Margin="0,0,0,10"
                   HorizontalOptions="Center"/>

            <Label Text="SISTEMA DE GESTIÓN"
                   TextColor="#D4A373"
                   FontSize="12"
                   CharacterSpacing="3"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,40"/>

            <VerticalStackLayout Spacing="20">

                <VerticalStackLayout Spacing="5">
                    <Label Text="Email" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                    <Entry Text="{Binding Email}" 
                           Placeholder="correo@ejemplo.com"
                           PlaceholderColor="Gray"
                           TextColor="White" 
                           BackgroundColor="#2C3E50"
                           HeightRequest="50"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Contraseña" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                    <Entry Text="{Binding Password}" 
                           IsPassword="True"
                           Placeholder="••••••••"
                           PlaceholderColor="Gray"
                           TextColor="White"
                           BackgroundColor="#2C3E50"
                           HeightRequest="50"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding RecordarContraseña}" Color="#D4A373" />
                    <Label Text="Recordar contraseña" VerticalOptions="Center" TextColor="White" />
                </HorizontalStackLayout>

                <Button Text="INICIAR SESIÓN"
                        Command="{Binding IniciarSesionCommand}"
                        BackgroundColor="#34495E"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="10" />

                <Button Text="REGISTRARSE"
                        Command="{Binding RegistrarseCommand}"
                        BackgroundColor="#D4A373"
                        TextColor="#1B2A3E"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="10" />

            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding EstaDescargando}" 
                               Color="#D4A373" 
                               Margin="0,20"
                               HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>