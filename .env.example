# Variables de entorno (plantilla). Copiar a `.env` en local sin valores reales.
# La API carga el `.env` de la raíz al arranque (LocalEnvFileLoader); las claves
# NEXT_PUBLIC_* van en `frontend/.env.local` (las lee Next.js).
# Nunca subir `.env` ni archivos de credenciales al repositorio.
#
# En Render NO se usa este archivo: las variables se cargan en el dashboard
# con las claves de la columna "Clave en Render" (ver docs/deployment-render.md).

# --- Backend / PostgreSQL ---
# La API lee: ConnectionStrings__DefaultConnection o DATABASE_CONNECTION_STRING
DATABASE_CONNECTION_STRING="Host=localhost;Port=5432;Database=sistemagestion;Username=postgres;Password=postgres"

# --- Backend / Firebase (Authentication + archivos privados) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Alternativa al par client-email/private-key: JSON del service account completo
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Backend / Supabase Storage (imágenes del catálogo y showroom) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_STORAGE_BUCKET=productos
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend / Gemini (opcional) ---
# La clave se lee como Gemini:ApiKey. Si se omite, /api/gemini no responde.
Gemini__ApiKey=

# --- Backend / CORS ---
# Orígenes separados por coma.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Backend / Migraciones automáticas (solo producción/contenedores) ---
# Database__MigrateOnStartup=true

# --- Frontend / API (va en frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:7100

# Configuración pública del SDK web de Firebase (no son secretos: viajan al
# navegador). Copiar los valores del proyecto en Firebase Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcionales
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CURRENCY=ARS
