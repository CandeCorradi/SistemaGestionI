@page "/clientes"
@inject IGenericService<Cliente> _serviceClientes


<PageTitle>Clientes</PageTitle>

<h1>Clientes</h1>

@if 
(
    clientes == null)
{
    <p><em>Cargando la lista de capacitaciones...</em></p>
}
else if (!clientes.Any())
{
    <p><em>No hay clientes registrados.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono</th>
                <th>Dirección</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cli in clientes)
            {
                <tr>
                    <td>@cli.Nombre</td>
                    <td>@cli.Apellido</td>
                    <td>@cli.Telefono</td>
                    <td>@cli.Direccion</td>
                </tr>
            }
        </tbody>
    </table>
}

)

@code 
{
    private List<Cliente>? clientes;
    protected override async Task OnInitializedAsync()
    {
        clientes = (await _serviceClientes.GetAllAsync(null))?.ToList();
    }
}


