<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MovilApp.ViewModels.Clientes"
             x:Class="MovilApp.Views.Clientes.Clientes"
             Title="Clientes">
    <ContentPage.BindingContext>
        <vm:ClientesViewModel />
    </ContentPage.BindingContext>
    <ScrollView Padding="20" BackgroundColor="#F5F5F5">
        <StackLayout Spacing="20">

            <Frame BackgroundColor="#1B2A3E" 
               Padding="25" 
               CornerRadius="0" 
               HasShadow="True"
               Margin="-20,-20,-20,0">
                <StackLayout>
                    <Label Text="CARPINTERÍA" 
                       FontSize="12"
                       CharacterSpacing="2"
                       TextColor="#D4A373" 
                       HorizontalOptions="Center"
                       FontAttributes="Bold"/>
                    <Label Text="Gestión de Clientes" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>

            <Frame BackgroundColor="White" 
               Padding="20" 
               CornerRadius="10" 
               HasShadow="False"
               BorderColor="#E0E0E0">
                <StackLayout Spacing="15">
                    <Label Text="¿A quién buscas?" 
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#1B2A3E"/>

                    <Frame BackgroundColor="#F9F9F9" 
                       Padding="2" 
                       CornerRadius="5"
                       HasShadow="False"
                       BorderColor="#D4A373">
                        <SearchBar Placeholder="Nombre, apellido o DNI..." 
                               Text="{Binding TextoBusqueda}"
                               SearchCommand="{Binding BuscarCommand}"
                               BackgroundColor="Transparent"
                               PlaceholderColor="Silver"
                               TextColor="#1B2A3E"
                               FontSize="15"/>
                    </Frame>

                    <Button Text="BUSCAR CLIENTE" 
                        Command="{Binding BuscarCommand}"
                        BackgroundColor="#1B2A3E"
                        TextColor="White"
                        CornerRadius="5"
                        FontAttributes="Bold"
                        HeightRequest="45"/>
                </StackLayout>
            </Frame>

            <StackLayout Spacing="10">
                <Label Text="{Binding Clientes.Count, StringFormat='{0} Clientes registrados'}"
                   FontSize="13"
                   TextColor="Gray"
                   HorizontalOptions="Start"
                   Margin="5,0"/>

                <CollectionView ItemsSource="{Binding Clientes}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="White" 
                               Padding="15" 
                               Margin="0,5"
                               CornerRadius="8"
                               HasShadow="False"
                               BorderColor="#E0E0E0">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">

                                    <Border Grid.Column="0"
                                        WidthRequest="50"
                                        HeightRequest="50"
                                        BackgroundColor="#F0F4F8"
                                        StrokeShape="RoundRectangle 25">
                                        <Label Text="👤" 
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#1B2A3E"/>
                                        <Label Text="{Binding Apellido}" 
                                           FontSize="14"
                                           TextColor="#555555"
                                           Margin="0,-3,0,0"/>
                                        <Label Text="{Binding Telefono}" 
                                           FontSize="12"
                                           TextColor="#D4A373"
                                           FontAttributes="Italic"/>
                                    </VerticalStackLayout>

                                    <BoxView Grid.Column="2" 
                                         WidthRequest="4" 
                                         BackgroundColor="#D4A373" 
                                         CornerRadius="2"
                                         VerticalOptions="Fill"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>