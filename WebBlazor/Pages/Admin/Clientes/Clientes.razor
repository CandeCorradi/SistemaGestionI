@page "/clientes"
@inject IGenericService<Cliente> _serviceClientes
@inject NavigationManager _navigationManager
@inject SweetAlertService _sweetAlertService
@inject FirebaseAuthService _authService


<PageTitle>Clientes</PageTitle>

<h1>Clientes</h1>

@if 
(
    clientes == null)
{
    <p><em>Cargando la lista de clientes...</em></p>
}
else if (!clientes.Any())
{
    <p><em>No hay clientes registrados.</em></p>
}
else
{
    <NavLink class="btn btn-primary mb-3" href=@($"NuevoEditarCliente")>
        Nuevo Cliente
    </NavLink>
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono</th>
                <th>Dirección</th>
                <th colspan="2">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cli in clientes)
            {
                <tr>
                    <td>@cli.Nombre</td>
                    <td>@cli.Apellido</td>
                    <td>@cli.Telefono</td>
                    <td>@cli.Direccion</td>
                    <td><button class="btn btn-danger" @onclick=" () => DeleteCliente (cli)">Eliminar</button></td>
                    <td><NavLink class="btn btn-info" href=@($"NuevoEditarCliente?idCliente={cli.Id}")>Editar</NavLink></td>
                </tr>
            }
        </tbody>
    </table>
}



@code 
{
    private List<Cliente>? clientes;
    protected override async Task OnInitializedAsync()
    {
        {
            if (!await _authService.IsUserAuthenticated())
            {
                _navigationManager.NavigateTo("/login");
                return;
            }
            clientes = (await _serviceClientes.GetAllAsync(null))?.ToList();
        }
    }
    private async Task DeleteCliente(Cliente cliente)
    {
        var response = await _sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "¿Estás seguro?",
            Text = $"¿Deseas eliminar al cliente {cliente.Nombre}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });
        if (response.IsConfirmed)
        {
            if (await _serviceClientes.DeleteAsync(cliente.Id))
            {
                await _sweetAlertService.FireAsync("Eliminado", "El cliente ha sido eliminado.", SweetAlertIcon.Success);
            } else
            {
                await _sweetAlertService.FireAsync("Error", "No se pudo eliminar el cliente.", SweetAlertIcon.Error);
            }
        }        
    }
}


