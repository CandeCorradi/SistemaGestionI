<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="MovilApp.Views.Login.SignInView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:login="clr-namespace:MovilApp.ViewModels.Login"
    BackgroundColor="#1B2A3E">
    <ContentPage.BindingContext>
        <login:SignInViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Start" Padding="25" Spacing="10">

            <Button Text="←"
                    Command="{Binding VolverCommand}"
                    BackgroundColor="Transparent"
                    BorderColor="#D4A373"
                    BorderWidth="2"
                    CornerRadius="25"   
                    TextColor="#D4A373"
                    FontSize="24"
                    HorizontalOptions="Start"
                    WidthRequest="50"
                    HeightRequest="50"
                    Margin="0,0,0,10"
                    Padding="0,0,0,5"/>

            <Label Text="CREAR CUENTA"
                   TextColor="White"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,5"/>

            <Label Text="Completa tus datos"
                   TextColor="#D4A373"
                   FontSize="14"
                   HorizontalOptions="Center"
                   Margin="0,0,0,25"/>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                  ColumnDefinitions="120,*" 
                  RowSpacing="15">

                <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" TextColor="White" VerticalTextAlignment="Center" FontAttributes="Bold"/>
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextColor="White" BackgroundColor="#2C3E50" HeightRequest="45" Placeholder="Tu nombre"/>

                <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" TextColor="White" VerticalTextAlignment="Center" FontAttributes="Bold"/>
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Lastname}" TextColor="White" BackgroundColor="#2C3E50" HeightRequest="45" Placeholder="Tu apellido"/>

                <Label Grid.Row="2" Grid.Column="0" Text="DNI:" TextColor="White" VerticalTextAlignment="Center" FontAttributes="Bold"/>
                <Entry Grid.Row="2" Grid.Column="1" Text="{Binding Dni}" TextColor="White" BackgroundColor="#2C3E50" HeightRequest="45" Keyboard="Numeric" Placeholder="Documento"/>

                <Label Grid.Row="3" Grid.Column="0" Text="Email:" TextColor="White" VerticalTextAlignment="Center" FontAttributes="Bold"/>
                <Entry Grid.Row="3" Grid.Column="1" Text="{Binding Email}" TextColor="White" BackgroundColor="#2C3E50" HeightRequest="45" Keyboard="Email" Placeholder="correo@ejemplo.com"/>

                <Label Grid.Row="4" Grid.Column="0" Text="Contraseña:" TextColor="White" VerticalTextAlignment="Center" FontAttributes="Bold"/>
                <Entry Grid.Row="4" Grid.Column="1" Text="{Binding Password}" IsPassword="True" TextColor="White" BackgroundColor="#2C3E50" HeightRequest="45" Placeholder="••••••••"/>

                <Label Grid.Row="5" Grid.Column="0" Text="Verificar:" TextColor="White" VerticalTextAlignment="Center" FontAttributes="Bold"/>
                <Entry Grid.Row="5" Grid.Column="1" Text="{Binding VerifyPassword}" IsPassword="True" TextColor="White" BackgroundColor="#2C3E50" HeightRequest="45" Placeholder="Repite contraseña"/>

                <Button Text="FINALIZAR REGISTRO"
                        Command="{Binding RegistrarseCommand}"
                        Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="0,20,0,0" 
                        BackgroundColor="#D4A373" 
                        TextColor="#1B2A3E" 
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="10"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>