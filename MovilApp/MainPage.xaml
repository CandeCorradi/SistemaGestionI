<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilApp.MainPage"
             BackgroundColor="#F5F5F5">
    

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Frame BackgroundColor="#1B2A3E" 
                   HeightRequest="250" 
                   CornerRadius="0" 
                   HasShadow="True"
                   BorderColor="Transparent">
                <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                    <Image Source="logo_carpinteria.png" 
                           HeightRequest="160"
                           HorizontalOptions="Center"
                           Aspect="AspectFit"/>

                    <Label Text="SISTEMA DE GESTIÓN" 
                           TextColor="#D4A373"
                           FontSize="14"
                           FontAttributes="Bold"
                           CharacterSpacing="3"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout Padding="30" Spacing="25">

                <VerticalStackLayout Spacing="5">
                    <Label Text="¡Bienvenido de nuevo!" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="#1B2A3E"
                           HorizontalOptions="Center"/>
                    <Label Text="¿Qué vamos a fabricar hoy?" 
                           FontSize="16" 
                           TextColor="Gray" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" HeightRequest="150">

                    <Frame Grid.Column="0" 
                           BackgroundColor="White" 
                           BorderColor="#E0E0E0" 
                           Padding="15" 
                           CornerRadius="12">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrAClientesCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                            <Label Text="👥" FontSize="30" HorizontalOptions="Center"/>
                            <Label Text="CLIENTES" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="#1B2A3E" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" 
                           BackgroundColor="White" 
                           BorderColor="#E0E0E0" 
                           Padding="15" 
                           CornerRadius="12">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                            <Label Text="🪑" FontSize="30" HorizontalOptions="Center"/>
                            <Label Text="PROYECTOS" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="#1B2A3E" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#D4A373" Margin="40,10"/>
                <Label Text="Calidad y Precisión en cada detalle" 
                       HorizontalOptions="Center" 
                       FontSize="12" 
                       FontAttributes="Italic" 
                       TextColor="Silver"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
